{
  "branches": ["main"],
  "tagFormat": "api-v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "scope": "api", "type": "feat", "release": "minor" },
          { "scope": "api", "type": "fix", "release": "patch" },
          { "scope": "api", "type": "perf", "release": "patch" },
          { "scope": "api", "type": "refactor", "release": "patch" },
          { "scope": "api", "breaking": true, "release": "major" },
          { "scope": "all", "type": "feat", "release": "minor" },
          { "scope": "all", "type": "fix", "release": "patch" },
          { "scope": "all", "type": "perf", "release": "patch" },
          { "scope": "all", "type": "refactor", "release": "patch" },
          { "scope": "all", "breaking": true, "release": "major" }
        ]
      }
    ],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/github", { "successComment": false, "failTitle": false, "labels": false }]
  ]
}
