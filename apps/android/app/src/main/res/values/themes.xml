<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash/activity theme. Status bar transparent so the Compose
         sakura gradient painted by JourneyApp bleeds behind it when
         enableEdgeToEdge() is on. -->
    <style name="Theme.Journey" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sakura_50</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
